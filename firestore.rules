rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One doc per admin. Doc ID = their Firebase Auth UID.
    // Created manually in the console (step 6 of FIREBASE_SETUP.md) — never through the app.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Gallery photos shown on the public site. Anyone can read; only an admin can change them.
    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- Reserved for future phases: schema is live now, UI/dashboard pages come later ----

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;        // lets the public contact form submit
      allow read, update, delete: if isAdmin();
    }

    // Deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
