rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One doc per admin. Doc ID = their Firebase Auth UID.
    // Created manually in the console (step 6 of FIREBASE_SETUP.md) — never through the app.
    // Users may read *their own* admin doc so isAdmin() can use exists() without a circular rule.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Gallery photos shown on the public site. Anyone can read; only an admin can change them.
    // Photos are stored as base64 image data directly on the document (no Firebase Storage,
    // no billing account needed) — the size check keeps every write safely under Firestore's
    // 1 MiB per-document ceiling. Matches the MAX_ENCODED_BYTES budget in admin/js/gallery.js.
    match /gallery/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() < 900000
        && request.resource.data.caption is string
        && request.resource.data.caption.size() < 200;
      allow delete: if isAdmin();

      // Public likes, one per visitor. The document ID *is* the visitor's Firebase
      // Auth UID (anonymous or admin), so nobody can create a like at any path but
      // their own -- Firestore itself refuses a second like from the same identity,
      // this isn't just a client-side check. Unliking is a delete of that same doc.
      // Nothing here can touch the gallery document above; this is a separate,
      // independently-secured subcollection.
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['likedAt'])
          && request.resource.data.likedAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---- Reserved for future phases: schema is live now, UI/dashboard pages come later ----

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'address', 'message', 'createdAt', 'source'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() < 40
        && request.resource.data.email is string
        && request.resource.data.email.size() < 120
        && request.resource.data.address is string
        && request.resource.data.address.size() < 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        && request.resource.data.source is string
        && request.resource.data.source.size() < 40
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
