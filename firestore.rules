rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // One doc per admin. Doc ID = their Firebase Auth UID.
    // Created manually in the console (step 6 of FIREBASE_SETUP.md) — never through the app.
    // Users may read *their own* admin doc so isAdmin() can use exists() without a circular rule.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // Gallery photos shown on the public site. Anyone can read; only an admin can change them.
    // Photos are stored as base64 image data directly on the document (no Firebase Storage,
    // no billing account needed) — the size check keeps every write safely under Firestore's
    // 1 MiB per-document ceiling (the admin page itself stays under ~720,000 characters).
    //
    // KEEP IN SYNC with admin/js/gallery.js:
    //   caption limit = MAX_CAPTION (300)   |   categories = CATEGORIES (completed, in-progress)
    // (The old rule capped captions at 199 characters while the form allowed 300, so a long
    //  description made the upload fail with a misleading "not an admin" style error.)
    function validPhoto(d) {
      return d.imageData is string
        && d.imageData.size() < 900000
        && d.caption is string
        && d.caption.size() <= 300
        && (!('category' in d) || d.category in ['completed', 'in-progress'])
        && (!('featured' in d) || d.featured is bool);
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPhoto(request.resource.data);
      allow delete: if isAdmin();

      // Public likes, one per visitor. The document ID *is* the visitor's Firebase
      // Auth UID (anonymous or admin), so nobody can create a like at any path but
      // their own -- Firestore itself refuses a second like from the same identity,
      // this isn't just a client-side check. Unliking is a delete of that same doc.
      // Nothing here can touch the gallery document above; this is a separate,
      // independently-secured subcollection.
      match /likes/{uid} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/gallery/$(imageId))
          && request.resource.data.keys().hasOnly(['likedAt'])
          && request.resource.data.likedAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---- Reserved for future phases: schema is live now, UI/dashboard pages come later ----

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Nothing on the site writes to `messages` yet (the contact form uses WhatsApp / mailto), but the
    // old rule let ANY visitor create documents here with no limit -- an open door for spam that
    // eats your free Firestore quota. Closed until a real inbox exists. When you build one, re-open
    // creates behind Firebase App Check (or a server route) rather than to the whole internet.
    match /messages/{messageId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
